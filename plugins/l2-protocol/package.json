{
  "name": "dsh-role-chain-protocol",
  "version": "0.2.0-rc.1",
  "description": "Fourteen role-chain tools for controlled round execution, durable stop intent, fixed deadlines, request usage accounting and independent evidence. Compute requires full read-only confinement; partial backends are refused.",
  "files": ["lib/", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "DESIGN.md", "ACCEPTANCE.md", "test/results/windows.json"],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weihao654/dsh-workflow.git",
    "directory": "plugins/l2-protocol"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "workflow",
    "round",
    "audit",
    "subagent",
    "role-chain"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
